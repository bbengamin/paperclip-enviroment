# Shared installed-tool policy for both deployment modes.
#
# Update this file first when changing installed agent apps or version pins.
# Dockerfiles consume it through scripts/install-common-tools.sh.

SSH_NODE_MAJOR="22"

CODEX_NPM_PACKAGE="@openai/codex"
# Resolve the current npm release when either image is built. The baked CLI
# remains fixed for the lifetime of that image; rebuilding is what picks up a
# newer release. Keep Codex smoke/streaming checks in the image release gate.
CODEX_VERSION="latest"

CLAUDE_NPM_PACKAGE="@anthropic-ai/claude-code"
CLAUDE_VERSION="latest"

OPENCODE_NPM_PACKAGE="opencode-ai"
OPENCODE_VERSION="latest"

PLAYWRIGHT_NPM_PACKAGE="playwright"
PLAYWRIGHT_VERSION="latest"
PLAYWRIGHT_BROWSERS_PATH="/ms-playwright"
PLAYWRIGHT_BROWSER="chromium"
