# Shared installed-tool policy for both deployment modes.
#
# Update this file first when changing installed agent apps or version pins.
# Dockerfiles consume it through scripts/install-common-tools.sh.

SSH_NODE_MAJOR="22"

CODEX_NPM_PACKAGE="@openai/codex"
# Pinned deliberately. Was unpinned at runtime by the codex_remote adapter
# (npm i -g @openai/codex = latest), which silently tracked new Codex releases
# and, on 2026-07-06, was the leading suspect for `codex exec --json` no longer
# streaming stdout incrementally (buffered until process exit). The adapter's
# runtime install has been removed; this baked version is now authoritative for
# both the SSH and Cloudflare images. Bump only after verifying streaming.
CODEX_VERSION="0.142.4"

CLAUDE_NPM_PACKAGE="@anthropic-ai/claude-code"
CLAUDE_VERSION="latest"

OPENCODE_NPM_PACKAGE="opencode-ai"
OPENCODE_VERSION="latest"

PLAYWRIGHT_NPM_PACKAGE="playwright"
PLAYWRIGHT_VERSION="latest"
PLAYWRIGHT_BROWSERS_PATH="/ms-playwright"
PLAYWRIGHT_BROWSER="chromium"
