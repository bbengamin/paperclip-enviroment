SSH_USER=guest
SSH_UID=1000
SSH_GID=1000
HOST_BIND_IP=100.x.y.z
AUTHORIZED_KEYS_SOURCE=./authorized_keys
DOCKER_IMAGE=bbengamin/paperclip-enviroment
DOCKER_TAG=latest
PAPERCLIP_PREVIEW_GATEWAY_HOST_PORT=3999
PAPERCLIP_PREVIEW_GATEWAY_ENABLED=1
# Stable target id used in signed SSH preview URLs:
# /preview/<PAPERCLIP_PREVIEW_ENVIRONMENT_ID>/<port>/...
PAPERCLIP_PREVIEW_ENVIRONMENT_ID=
# Required for signed preview URLs. Missing value only disables previews; SSH still starts.
PREVIEW_SIGNING_SECRET=
PAPERCLIP_PREVIEW_ALLOWED_PORTS=3000,3001,4000,4200,5000,5173,5174,8000,8080,9000
# Optional Anthropic-compatible endpoint settings propagated into the SSH environment.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
# Docker-in-Docker runtime mode for the SSH environment:
#   rootless = isolated, self-owned dockerd per environment (default)
#   off      = do not start Docker inside the container
DOCKER_RUNTIME=rootless
