SSH_USER=guest
SSH_UID=1000
SSH_GID=1000
HOST_BIND_IP=100.x.y.z
AUTHORIZED_KEYS_SOURCE=./authorized_keys
DOCKER_IMAGE=bbengamin/paperclip-enviroment
DOCKER_TAG=latest
# Docker-in-Docker runtime mode for the SSH environment:
#   rootless = isolated, self-owned dockerd per environment (default)
#   off      = do not start Docker inside the container
DOCKER_RUNTIME=rootless
